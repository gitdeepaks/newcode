datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../generated"
}

model Session {
  id        String   @id @default(cuid())
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]
  events   SessionEvent[]

  @@index([updatedAt(sort: Desc)])
}

model Message {
  id        String      @id
  sessionId String
  role      MessageRole
  model     String?
  payload   Json
  createdAt DateTime    @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model SessionEvent {
  id        String           @id @default(cuid())
  sessionId String?
  kind      SessionEventKind
  payload   Json
  createdAt DateTime         @default(now())

  session Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([kind, createdAt])
}

enum MessageRole {
  user
  assistant
  system
}

enum SessionEventKind {
  stream_start
  stream_finish
  stream_error
  tool_error
  validation_error
  config_error
  aborted
}
