    "@newcode/payments": "workspace:*",
    "@newcode/shared": "workspace:*",
    "ai": "^7.0.4",
    "hono": "^4.10.0",
    "newcode-ai": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  }
}
